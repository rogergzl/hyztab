# 复制为 .env 后按需修改：cp .env.example .env

# 管理界面登录令牌（必填）。请改成自己的强随机字符串。
RELAY_ADMIN_TOKEN=change-me-to-a-long-random-string

# 宿主机映射端口（容器内固定 8787）
RELAY_PORT=8787

# 反向代理子路径，例如 /relay。直连留空。
RELAY_BASE_PATH=

# 代理访问是否也需要令牌。公网部署建议 true；纯内网可 false。
RELAY_PROXY_TOKEN=false

# 是否允许代理访问私网地址（127.0.0.1 / 192.168.x / 10.x 等）。
# 若只做公网中转建议 false 以防 SSRF；需要访问内网服务则 true。
RELAY_ALLOW_PRIVATE=true

# 日志最多保留条数（超出自动裁剪）。
RELAY_MAX_LOGS=5000
