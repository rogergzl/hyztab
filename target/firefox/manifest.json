{
  "manifest_version": 2,
  "name": "花与竹标签",
  "short_name": "花与竹",
  "version": "2.6.0",
  "description": "一个漂亮、可自定义的新标签页，拥有多种背景和组件。",
  "homepage_url": "https://aphqsia.com/",
  "applications": {
    "gecko": {
      "id": "huayuzhu@aphqsia.com",
      "strict_min_version": "54.0"
    }
  },
  "chrome_settings_overrides": {
    "homepage": "index.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["<all_urls>"]
}
